{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "declaration": true,
    "esModuleInterop": true,
    // TS 6 renamed "node" to "node10" and deprecated it (removal in TS 7). The real
    // replacement for a bundler-consumed esnext-module library is "bundler" resolution,
    // which is a bigger migration to verify across all 3 tsconfigs at once — this flag
    // is the TS-endorsed interim opt-out (see TS5107) to unblock the current major
    // without changing actual resolution behavior.
    "ignoreDeprecations": "6.0",
    "inlineSources": true,
    // BigInt/BigInt64Array (web.ts, @sqlite.org/sqlite-wasm's .d.mts), Promise.finally,
    // and Error.cause (web.ts) all need at least es2020/es2022 lib types; an explicit
    // "lib" replaces rather than extends what "target" alone would otherwise imply, so
    // this must be listed even though "target" stays es2017 for output syntax. Every
    // runtime this plugin targets (Node 24+, and browsers new enough for the OPFS/
    // SharedArrayBuffer support the Web build already requires) supports ES2022 at
    // runtime, so there's no reason to hand-pick older/narrower lib pieces.
    "lib": ["dom", "es2022"],
    "module": "esnext",
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist/esm",
    "pretty": true,
    // TS 6 requires this explicitly now (TS5011) instead of inferring it from the common
    // ancestor of the input files — `index.ts`'s transitive imports all resolve under `src/`.
    "rootDir": "./src",
    "sourceMap": true,
    "strict": true,
    "target": "es2017"
  },
  "files": ["src/index.ts"]
}
