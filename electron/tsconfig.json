{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    // See tsconfig.json for why this is needed (TS 6 deprecated "node" resolution).
    "ignoreDeprecations": "6.0",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "build",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "target": "ES2017",
    "types": ["node"]
  },
  "include": ["src/**/*", "types/**/*"]
}
